    [10], [Инверсия $y$ (НЕ $y$)], [$overline(y)$], [1], [0], [1], [0],
    [11], [Обратная импликация], [$x <- y$], [1], [0], [1], [1],
    [12], [Инверсия $x$ (НЕ $x$)], [$overline(x)$], [1], [1], [0], [0],
    [13], [Прямая импликация], [$x arrow.r y$], [1], [1], [0], [1],
