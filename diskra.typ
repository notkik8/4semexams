    #place(top + left, dx: 50pt, dy: 20pt, rect(width: 80pt, height: 80pt, stroke: 1pt + luma(180)))
    
    // Вершины и их значения
    // Вершина (0,1) - верх-лево, f=1
    #place(top + left, dx: 50pt - 4pt, dy: 20pt - 4pt, circle(radius: 4pt, fill: rgb("1c7ed6")))
    #place(top + left, dx: -5pt, dy: 13pt)[$(0,1) -> bold(1)$]
    
    // Вершина (1,1) - верх-право, f=0
    #place(top + left, dx: 130pt - 4pt, dy: 20pt - 4pt, circle(radius: 4pt, fill: white, stroke: 1.5pt + luma(150)))
    #place(top + left, dx: 138pt, dy: 13pt)[$(1,1) -> bold(0)$]
    
    // Вершина (0,0) - низ-лево, f=0
    #place(top + left, dx: 50pt - 4pt, dy: 100pt - 4pt, circle(radius: 4pt, fill: white, stroke: 1.5pt + luma(150)))
    #place(top + left, dx: -5pt, dy: 93pt)[$(0,0) -> bold(0)$]
    
    // Вершина (1,0) - низ-право, f=1
    #place(top + left, dx: 130pt - 4pt, dy: 100pt - 4pt, circle(radius: 4pt, fill: rgb("1c7ed6")))
    #place(top + left, dx: 138pt, dy: 93pt)[$(1,0) -> bold(1)$]
  ]
