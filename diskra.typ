    [0], [Константа 0], [$0$], [0], [0], [0], [0],
    [1], [Конъюнкция (И)], [$x and y$], [0], [0], [0], [1],
    [2], [Запрет по $y$], [$x and overline(y)$], [0], [0], [1], [0],
    [3], [Повторение $x$], [$x$], [0], [0], [1], [1],
    [4], [Запрет по $x$], [$overline(x) and y$], [0], [1], [0], [0],
    [5], [Повторение $y$], [$y$], [0], [1], [0], [1],
    [6], [Сумма по модулю 2 (XOR)], [$x plus.o y$], [0], [1], [1], [0],
